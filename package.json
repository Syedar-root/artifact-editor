{
  "name": "artifact-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace @artifact-editor/web",
    "dev:server": "npm run dev --workspace @artifact-editor/server",
    "build": "npm run build --workspace @artifact-editor/web",
    "test": "npm run test --workspace @artifact-editor/source-locator && npm run test --workspace @artifact-editor/web",
    "test:editor": "npm run test:editor --workspace @artifact-editor/web",
    "test:inspector": "npm run test:inspector --workspace @artifact-editor/web",
    "typecheck": "npm run typecheck --workspace @artifact-editor/web",
    "check:server": "npm run check --workspace @artifact-editor/server",
    "start": "npm run start --workspace @artifact-editor/server"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
