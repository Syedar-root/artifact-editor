# 模型凭据只由 Server 读取，不进入沙箱。兼容原 API_KEY / BASE_URL / MODEL。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AIO Sandbox HTTP 服务；无需 Server 访问 Docker socket 或运行 docker exec。
ARTIFACT_SANDBOX_URL=http://127.0.0.1:18080
# 沙箱开启 JWT 鉴权时填写 Bearer token；不要填写模型 API key。
ARTIFACT_SANDBOX_TOKEN=
# 沙箱内的路径；NAS 放源码，本地 SSD 放依赖。两个目录须由沙箱执行用户读写。
ARTIFACT_WORKSPACE_ROOT=/workspace
ARTIFACT_DEPENDENCY_ROOT=/opt/artifact-dependencies
# 新产物的默认包管理器。已有产物优先使用 packageManager 声明或现有 lockfile。
# 使用 pnpm 前需在沙箱镜像中安装 pnpm；支持 npm / pnpm。
ARTIFACT_PACKAGE_MANAGER=pnpm
# Server 本地持久化路径，可改为持久卷；不要放到沙箱中。
ARTIFACT_SESSION_ROOT=.artifact-server/sessions
# Server 可访问的持久化构建目录；生产时指向 Server 上的 NAS 挂载路径。
ARTIFACT_RELEASE_ROOT=mock-nas/releases
# 沙箱内的临时构建目录，使用快速存储并与源码、依赖目录分离。
ARTIFACT_BUILD_ROOT=/tmp/artifact-builds
