{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@artifact-editor/sdk/web": ["../../packages/sdk/src/web/index.ts"],
      "@artifact-editor/sdk/web/react": ["../../packages/sdk/src/web/react/index.ts"],
      "@artifact-editor/sdk/web/overlay": ["../../packages/sdk/src/web/element-inspector-overlay/index.ts"],
      "@artifact-editor/sdk/web/element-inspector": ["../../packages/sdk/src/web/element-inspector/index.ts"],
      "@artifact-editor/sdk/web/element-editor": ["../../packages/sdk/src/web/element-editor/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
